import asyncio
from pyrogram import Client
from pyrogram.raw.functions.phone import EditGroupCallParticipant
from pyrogram.raw.types import InputGroupCall, InputPeerUser
from pyrogram.errors import UserNotParticipant

API_ID = 26721205
API_HASH = "fcfa49b53c5bcae67ba2218ee36e24e3"
STRING_SESSION = "BQGXu7UAcrAgwpuAz8qDWk5n_JwbFBs0Rm-NZRK8MLrt-EqPZ3JJOawybhhEI5LstWoHfuyFZlRewlqqzFakZIP9lqnMQBD0y0Y-gIChZpJnHXuAED8XY7u1jG56LOmEFxl0I_x8VExlnsxMYXFCKUU5mormyI2QHbfGUCMlIoOWk6UiX5ZIckeoYqac9robr4Sya5AO31K7mao38iAOmmMonVE5oJSv-9jWF1pBbots3rxkIEZmJklMgMQSkyoJCoQxghHDb3cnUB_V3az9oaOIlVahbNLt8jAHbfGUwC-sEx74bOZfXPOX_53fDEm4_M_ZVbt520DdQ8s_ZBiY9hoCR0HK3gAAAAIAcw69AA"
MAIN_GROUP_ID = -1003526512085

app = Client(
    "vcguard",
    api_id=API_ID,
    api_hash=API_HASH,
    session_string=STRING_SESSION
)

# Track VC users
vc_users = {}

@app.on_raw_update()
async def voice_handler(client, update, users, chats):
    if update.__class__.__name__ != "UpdateGroupCallParticipants":
        return

    call = update.call
    participants = update.participants

    group_call = InputGroupCall(
        id=call.id,
        access_hash=call.access_hash
    )

    for p in participants:

        if not hasattr(p.peer, "user_id"):
            continue

        user_id = p.peer.user_id

        if user_id not in users:
            continue

        user = users[user_id]

        input_peer = InputPeerUser(
            user_id=user.id,
            access_hash=user.access_hash
        )

        # Save VC participant
        vc_users[user_id] = {
            "peer": input_peer,
            "call": group_call
        }

        # Mute immediately
        await app.invoke(
            EditGroupCallParticipant(
                call=group_call,
                participant=input_peer,
                muted=True
            )
        )

        print(f"{user_id} joined VC → muted")


async def verification_loop():
    while True:
        await asyncio.sleep(5)

        for user_id, data in list(vc_users.items()):
            input_peer = data["peer"]
            group_call = data["call"]

            try:
                await app.get_chat_member(MAIN_GROUP_ID, user_id)
                in_group = True
            except:
                in_group = False

            if in_group:
                # Unmute verified users
                await app.invoke(
                    EditGroupCallParticipant(
                        call=group_call,
                        participant=input_peer,
                        muted=False
                    )
                )
                print(f"{user_id} verified → unmuted")

            else:
                # Keep muted if not in group
                await app.invoke(
                    EditGroupCallParticipant(
                        call=group_call,
                        participant=input_peer,
                        muted=True
                    )
                )
                print(f"{user_id} not verified → still muted")


async def main():
    await app.start()
    print("VC Guard Running...")
    asyncio.create_task(verification_loop())
    await asyncio.Event().wait()

asyncio.run(main())
