import asyncio
from pyrogram import Client
from pyrogram.raw.functions.phone import EditGroupCallParticipant
from pyrogram.raw.types import InputGroupCall
from pyrogram.errors import UserNotParticipant

API_ID = 26721205
API_HASH = "fcfa49b53c5bcae67ba2218ee36e24e3"
STRING_SESSION = "BQGXu7UAcrAgwpuAz8qDWk5n_JwbFBs0Rm-NZRK8MLrt-EqPZ3JJOawybhhEI5LstWoHfuyFZlRewlqqzFakZIP9lqnMQBD0y0Y-gIChZpJnHXuAED8XY7u1jG56LOmEFxl0I_x8VExlnsxMYXFCKUU5mormyI2QHbfGUCMlIoOWk6UiX5ZIckeoYqac9robr4Sya5AO31K7mao38iAOmmMonVE5oJSv-9jWF1pBbots3rxkIEZmJklMgMQSkyoJCoQxghHDb3cnUB_V3az9oaOIlVahbNLt8jAHbfGUwC-sEx74bOZfXPOX_53fDEm4_M_ZVbt520DdQ8s_ZBiY9hoCR0HK3gAAAAIAcw69AA"
MAIN_GROUP_ID = -1003526512085  # Your main group ID

app = Client(
    "vcguard",
    api_id=API_ID,
    api_hash=API_HASH,
    session_string=STRING_SESSION
)

# Store already processed users (avoid loop spam)
processed_users = set()

@app.on_raw_update()
async def voice_handler(client, update, users, chats):
    try:
        if update.__class__.__name__ != "UpdateGroupCallParticipants":
            return

        call = update.call
        participants = update.participants

        group_call = InputGroupCall(
            id=call.id,
            access_hash=call.access_hash
        )

        for p in participants:

            # skip non-users
            if not hasattr(p.peer, "user_id"):
                continue

            user_id = p.peer.user_id

            # avoid repeating same action continuously
            if user_id in processed_users:
                continue

            processed_users.add(user_id)

            print(f"New VC participant: {user_id}")

            # 1️⃣ MUTE IMMEDIATELY
            await app.invoke(
                EditGroupCallParticipant(
                    call=group_call,
                    participant=p.peer,
                    muted=True
                )
            )

            # 2️⃣ CHECK GROUP MEMBERSHIP
            try:
                await app.get_chat_member(MAIN_GROUP_ID, user_id)
                in_group = True
            except UserNotParticipant:
                in_group = False
            except:
                in_group = False

            if not in_group:
                print(f"{user_id} not in group → kept muted")
                continue

            # 3️⃣ WAIT 5 SECONDS
            await asyncio.sleep(5)

            # 4️⃣ If user enabled video → mute again
            if hasattr(p, "video") and p.video:
                await app.invoke(
                    EditGroupCallParticipant(
                        call=group_call,
                        participant=p.peer,
                        muted=True
                    )
                )
                print(f"{user_id} tried video → muted")
            else:
                # 5️⃣ UNMUTE
                await app.invoke(
                    EditGroupCallParticipant(
                        call=group_call,
                        participant=p.peer,
                        muted=False
                    )
                )
                print(f"{user_id} unmuted successfully")

    except Exception as e:
        print("Error:", e)

app.run()
